NODE_ENV=development
PORT=3001

# JWT Configuration
JWT_ACCESS_SECRET=access-secret-change-me-minimum-16-characters
JWT_REFRESH_SECRET=refresh-secret-change-me-minimum-16-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Redis Configuration
# If Redis runs in Docker and exposes 6379 to host, keep 127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false

# API Key Configuration (internal microservice-to-microservice authentication)
# Required for all requests via x-api-key header
API_KEY=change-me-to-a-secure-api-key

# PostgreSQL Configuration
# External/local PostgreSQL (not managed by docker-compose in this project)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db
DB_LOGGING=false

# Google OAuth 2.0 Configuration
# Used for Google Sign-In ID token verification
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
