      "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [ "const json = pm.response.json(); pm.collectionVariables.set('managerAccessToken', json.accessToken || ''); pm.collectionVariables.set('managerRefreshToken', json.refreshToken || '');" ] } } ]
    },
    {
      "name": "03 - Register Inspector (ADMIN)",
