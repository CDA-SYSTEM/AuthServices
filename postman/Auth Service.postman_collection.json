          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString();",
              "if (!pm.collectionVariables.get('operarioIdentificationNumber')) {",
              "  pm.collectionVariables.set('operarioIdentificationNumber', '22'+suffix.slice(-8));",
              "}",
              "if (!pm.collectionVariables.get('operarioPhoneNumber')) {",
              "  pm.collectionVariables.set('operarioPhoneNumber', '301'+suffix.slice(-7));",
              "}",
              "if (!pm.collectionVariables.get('operarioEmail')) {",
              "  pm.collectionVariables.set('operarioEmail', 'operario.'+suffix+'@example.com');",
              "}"
            ]
          }
        },
